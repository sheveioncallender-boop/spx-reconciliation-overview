<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_spx_reconciliation_overview" model="report.paperformat">
        <field name="name">Reconciliation Overview Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">18</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">12</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_spx_reconciliation_overview" model="ir.actions.report">
        <field name="name">Reconciliation Overview</field>
        <field name="model">spx.bank.reconciliation.overview</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">spx_reconciliation_overview.report_reconciliation_overview</field>
        <field name="report_file">spx_reconciliation_overview.report_reconciliation_overview</field>
        <field name="binding_model_id" ref="model_spx_bank_reconciliation_overview"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_spx_reconciliation_overview"/>
        <field name="print_report_name">'Reconciliation - %s' % (object.name)</field>
    </record>

    <template id="report_reconciliation_overview">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Bank Reconciliation Overview</h2>
                        <table class="table table-sm table-borderless mb-3">
                            <tbody>
                                <tr>
                                    <td><strong>Bank Account</strong></td>
                                    <td><span t-field="doc.journal_id"/></td>
                                    <td><strong>Statement Date</strong></td>
                                    <td><span t-field="doc.statement_date"/></td>
                                    <td><strong>Status</strong></td>
                                    <td><span t-esc="dict(doc._fields['reconciliation_state'].selection).get(doc.reconciliation_state)"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Company</strong></td>
                                    <td><span t-field="doc.company_id"/></td>
                                    <td><strong>Period</strong></td>
                                    <td><span t-field="doc.date_from"/> – <span t-field="doc.statement_date"/></td>
                                    <td><strong>Last Refreshed</strong></td>
                                    <td><span t-field="doc.data_last_refreshed"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4>Checks, Deposits and Bank Transactions</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Cleared</th>
                                    <th>Reference</th>
                                    <th class="text-end">Deposit / Bank Credit</th>
                                    <th class="text-end">Check / Bank Debit</th>
                                    <th>Date</th>
                                    <th>Payee / Description</th>
                                    <th>Odoo Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td class="text-center"><span t-if="line.is_cleared">✓</span></td>
                                    <td><span t-field="line.reference"/></td>
                                    <td class="text-end">
                                        <span t-if="line.transaction_type == 'deposit'" t-field="line.amount"
                                              t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-if="line.transaction_type == 'check'" t-field="line.amount"
                                              t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                    </td>
                                    <td><span t-field="line.date"/></td>
                                    <td>
                                        <span t-field="line.partner_id"/>
                                        <t t-if="line.description"><br/><small t-field="line.description"/></t>
                                    </td>
                                    <td><span t-esc="dict(line._fields['native_status'].selection).get(line.native_status)"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row mt-4">
                            <div class="col-6">
                                <h4>Statement Adjustments</h4>
                                <table class="table table-sm table-bordered">
                                    <tbody>
                                        <tr>
                                            <td>Interest Income</td>
                                            <td class="text-end"><span t-field="doc.interest_income" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                            <td><span t-field="doc.interest_account_id"/></td>
                                        </tr>
                                        <tr>
                                            <td>Service Charges</td>
                                            <td class="text-end"><span t-field="doc.service_charges" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                            <td><span t-field="doc.service_charge_account_id"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-6">
                                <h4>Reconciliation Summary</h4>
                                <table class="table table-sm table-bordered">
                                    <tbody>
                                        <tr><td>Statement Ending Balance</td><td class="text-end"><span t-field="doc.statement_ending_balance" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                                        <tr><td>− Outstanding Checks</td><td class="text-end"><span t-field="doc.outstanding_checks" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                                        <tr><td>+ Deposits in Transit</td><td class="text-end"><span t-field="doc.deposits_in_transit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                                        <tr><td>= Adjusted Bank Balance</td><td class="text-end"><span t-field="doc.adjusted_bank_balance" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                                        <tr><td>− Adjusted G/L Balance</td><td class="text-end"><span t-field="doc.adjusted_gl_balance" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                                        <tr class="fw-bold"><td>= Unreconciled Difference</td><td class="text-end"><span t-field="doc.difference" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <p class="text-muted mt-3"><small>This report is a visibility worksheet. Odoo's native bank reconciliation remains the accounting source of truth.</small></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

