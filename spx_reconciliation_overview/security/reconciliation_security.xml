<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spx_reconciliation_overview_company_rule" model="ir.rule">
        <field name="name">Reconciliation Overview: company access</field>
        <field name="model_id" ref="model_spx_bank_reconciliation_overview"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="spx_reconciliation_overview_line_company_rule" model="ir.rule">
        <field name="name">Reconciliation Overview Lines: company access</field>
        <field name="model_id" ref="model_spx_bank_reconciliation_overview_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
</odoo>

